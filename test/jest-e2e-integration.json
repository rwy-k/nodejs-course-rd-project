{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "setupFiles": ["<rootDir>/e2e-integration-env.ts"],
  "testEnvironment": "node",
  "testRegex": "shipments-flow\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 30000,
  "detectOpenHandles": true,
  "forceExit": true
}
